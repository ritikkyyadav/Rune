# Rust
/target
**/target/
**/*.rs.bk

# Node / Bun
node_modules/
.turbo/
dist/
bun.lockb

# The web bundle's embed manifest: generated from apps/web/dist by
# scripts/gen-web-embed.ts before every compile, so the binary carries the
# client inside it (P10.9a). The generator is committed; its output is not.
packages/orchestrator/src/web-embed/generated.js

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Retired pre-rename project dir (config migrated to .gear/; local index DBs only)
.alan/

# Codex CLI session scratch
.codex/

# Eval run archives (CI uploads them as artifacts; baseline-mock.json is the committed gate)
tests/eval/results/run-*.json

# Gear runtime
.gear/cache/
.gear/logs/
# The mission dossier: per-workspace run state the engine rewrites every turn
.gear/mission.md
# Local code indexes (rebuilt on demand; WAL/SHM siblings included)
.gear/symbols.db*
.gear/search.db*
# Detached-run worktrees (git worktree checkouts; branches carry the work)
.gear/worktrees/
# MCP server config — local, may contain credentials in headers (see mcp.json.example)
.gear/mcp.json

# Environment
.env
.env.local

# Build artifacts
*.dmg
*.deb
*.rpm
*.AppImage

# Test artifacts
tests/fixtures/tmp/
# Byproducts of running the verifier fixtures' real toolchains
tests/fixtures/verifier/**/__pycache__/
tests/fixtures/verifier/**/*.class
tests/fixtures/verifier/**/Cargo.lock

# Playwright MCP session snapshots (browser tool scratch)
.playwright-mcp/

# local scratch — never commit
_to_delete/
*.tgz
*.tar.gz
# Packaged VS Code extension + its esbuild output (built, never committed)
*.vsix
apps/vscode/out/
# The VS Code build @vscode/test-electron downloads for the live extension proof
.vscode-test/
# terminal captures from TUI debugging (raw ANSI dumps)
*.cv.txt
