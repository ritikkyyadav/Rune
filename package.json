{
  "name": "gear-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/eval",
    "tests/e2e"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "bun test tests/unit/",
    "test:unit": "bun test tests/unit/",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "bun run tests/eval/runner.ts",
    "eval:auto-safety": "bun run tests/eval/auto-mode-safety.ts",
    "bench": "bun run tests/eval/runner.ts --real --tasks long_horizon",
    "bench:mock": "bun run tests/eval/runner.ts --tasks long_horizon",
    "test:integration": "bun test tests/integration/",
    "test:packages": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.10.11",
    "typescript": "^5.9.3",
    "prettier": "^3.9.6",
    "@types/bun": "latest"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26"
  }
}
