{
  "name": "alan-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/eval"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "eval": "bun run tests/eval/runner.ts"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.8",
    "prettier": "^3",
    "@types/bun": "latest"
  }
}
