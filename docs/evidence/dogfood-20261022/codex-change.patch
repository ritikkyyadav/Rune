diff --git a/tests/unit/orchestrator/model-unavailable.test.ts b/tests/unit/orchestrator/model-unavailable.test.ts
new file mode 100644
index 00000000..77f66a4c
--- /dev/null
+++ b/tests/unit/orchestrator/model-unavailable.test.ts
@@ -0,0 +1,171 @@
+import { describe, expect, mock, test } from "bun:test";
+import { LlmGateway } from "../../../packages/llm-gateway/src/gateway";
+import { ProviderHealthStore } from "../../../packages/llm-gateway/src/provider-health";
+import { ApiError, type LlmProvider } from "../../../packages/llm-gateway/src/types";
+import { AgentLoop, type AgentTurnEvent } from "../../../packages/orchestrator/src/agent-loop";
+import type { Engine } from "../../../packages/orchestrator/src/engine";
+import {
+  headlessEnvelope,
+  headlessExitCode,
+  runHeadless,
+} from "../../../packages/orchestrator/src/headless";
+import { isUnfinished, statusFromStopReason } from "../../../packages/orchestrator/src/lifecycle";
+import { toChildStatus } from "../../../packages/orchestrator/src/subagent-result";
+import { TaskStateStore } from "../../../packages/orchestrator/src/task-state";
+
+/** Exercise the real gateway, loop and headless reducer with a failing provider. */
+async function runFailure(
+  error: Error,
+  { plan = false, remembered = false, maxRateWaits = 0 } = {},
+) {
+  const inferStream = mock(async function* () {
+    throw error;
+  });
+  const provider: LlmProvider = {
+    name: "anthropic",
+    infer: async () => {
+      throw error;
+    },
+    inferStream,
+    countTokens: async () => 0,
+    healthCheck: async () => true,
+  };
+  const health = ProviderHealthStore.ephemeral();
+  if (remembered) health.noteRetired("anthropic", "old-model", "model was retired");
+  const gateway = new LlmGateway(
+    { providers: {}, defaultProvider: "anthropic", maxRetries: 2, retryBaseMs: 1 },
+    health,
+  );
+  gateway.registerProvider(provider);
+  const taskState = new TaskStateStore();
+  if (plan) {
+    taskState.beginTurn("build it");
+    taskState.setTodos([{ content: "unfinished work", status: "in_progress" }], { enforce: false });
+  }
+  const loop = new AgentLoop(
+    {
+      model: "old-model",
+      provider: "anthropic",
+      maxTokens: 100,
+      maxTurns: 12,
+      maxConsecutiveErrors: 2,
+      maxRateWaits,
+      systemPrompt: "s",
+      taskState,
+    },
+    gateway,
+    { toLlmTools: () => [] } as any,
+  );
+  const events: AgentTurnEvent[] = [];
+  const result = await runHeadless(
+    {
+      setPermissionHandler() {},
+      chat: () => loop.run("build it", "s1", "/tmp"),
+    } as unknown as Engine,
+    "s1",
+    "build it",
+    { onEvent: (event) => events.push(event) },
+  );
+  return {
+    events,
+    result,
+    envelope: JSON.parse(headlessEnvelope(result)),
+    calls: inferStream.mock.calls.length,
+    taskState,
+  };
+}
+
+describe("an unavailable model ends a headless run distinctly", () => {
+  for (const plan of [false, true]) {
+    test.each([404, 410])(
+      "HTTP %i ends model_unavailable without a retry (plan: " + plan + ")",
+      async (status) => {
+        const { calls, result, envelope, events, taskState } = await runFailure(
+          new ApiError({ status, provider: "anthropic", message: "model not found" }),
+          { plan },
+        );
+        expect(calls).toBe(1);
+        expect(result.stopReason).toBe("model_unavailable");
+        expect(result.ok).toBe(false);
+        expect(result.error).toContain("pick a current one with /model");
+        expect(envelope).toMatchObject({
+          ok: false,
+          stopReason: "model_unavailable",
+          subtype: "error_model_unavailable",
+        });
+        expect(envelope.error).toBe(result.error);
+        expect(headlessExitCode(result)).toBe(5);
+        expect(events.at(-1)).toMatchObject({
+          type: "turn_complete",
+          stopReason: "model_unavailable",
+        });
+        const fatalIndex = events.findIndex((e) => e.type === "error" && !e.recoverable);
+        expect(fatalIndex).toBeGreaterThanOrEqual(0);
+        expect(fatalIndex).toBeLessThan(events.length - 1);
+        expect(events.some((e) => e.type === "retry")).toBe(false);
+        if (plan) {
+          expect(taskState.hasOpenTodos()).toBe(true);
+          const handoffIndex = events.findIndex((e) => e.type === "handoff");
+          expect(handoffIndex).toBeGreaterThanOrEqual(0);
+          expect(handoffIndex).toBeLessThan(fatalIndex);
+          expect(taskState.snapshot().handoff?.state).toContain("unfinished work");
+        }
+      },
+    );
+  }
+
+  test("a remembered retirement has the same ending without a request", async () => {
+    const { calls, result, envelope } = await runFailure(new Error("must not be called"), {
+      remembered: true,
+    });
+    expect(calls).toBe(0);
+    expect(envelope).toMatchObject({
+      ok: false,
+      stopReason: "model_unavailable",
+      subtype: "error_model_unavailable",
+    });
+    expect(headlessExitCode(result)).toBe(5);
+  });
+
+  test("a model-gone error mentioning a rate limit still cannot enter the retry wait", async () => {
+    const { calls, envelope } = await runFailure(
+      new ApiError({ status: 404, provider: "anthropic", message: "rate limited; retry in ~1s" }),
+      { maxRateWaits: 2 },
+    );
+    expect(calls).toBe(1);
+    expect(envelope.subtype).toBe("error_model_unavailable");
+  }, 2000);
+
+  test("lifecycle and child summaries preserve the ending", () => {
+    expect(statusFromStopReason("model_unavailable")).toBe("model_unavailable");
+    expect(isUnfinished(statusFromStopReason("model_unavailable"))).toBe(true);
+    expect(toChildStatus("model_unavailable")).toBe("model_unavailable");
+  });
+});
+
+describe("other provider failures keep their endings", () => {
+  test.each([
+    [401, "invalid API key", "provider_lost", "error_provider"],
+    [403, "access denied", "provider_lost", "error_provider"],
+    [402, "no credits", "provider_lost", "error_provider"],
+    [429, "too many requests", "provider_lost", "error_provider"],
+    [429, "usage limit reached", "quota_wall", "error_quota"],
+    [503, "service unavailable", "provider_lost", "error_provider"],
+  ])("HTTP %i (%s) retains %s / %s", async (status, message, stopReason, subtype) => {
+    const { result, envelope } = await runFailure(
+      new ApiError({ status, provider: "anthropic", message }),
+    );
+    expect(envelope).toMatchObject({ ok: false, stopReason, subtype });
+    expect(headlessExitCode(result)).toBe(5);
+  });
+
+  test("a connection failure still ends provider_lost", async () => {
+    const { result, envelope } = await runFailure(new Error("socket hang up"));
+    expect(envelope).toMatchObject({
+      ok: false,
+      stopReason: "provider_lost",
+      subtype: "error_provider",
+    });
+    expect(headlessExitCode(result)).toBe(5);
+  });
+});
