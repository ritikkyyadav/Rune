diff --git a/tests/integration/headless-model-unavailable.test.ts b/tests/integration/headless-model-unavailable.test.ts
new file mode 100644
index 00000000..fbdc59b4
--- /dev/null
+++ b/tests/integration/headless-model-unavailable.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, test } from "bun:test";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { startMockModelServer } from "../helpers/mock-model-server";
+import { resolveRuneToolsBinary } from "../helpers/native-binary";
+import { makeFixture, makeScratchHome, spawnRun, type Run } from "../helpers/scenario";
+import { rmTemp } from "../helpers/tmp";
+
+describe("rune -P model unavailable", () => {
+  test.each([404, 410])(
+    "HTTP %i reports the retired-model ending without retrying",
+    async (status) => {
+      const root = mkdtempSync(join(tmpdir(), "rune-model-unavailable-"));
+      const server = startMockModelServer({
+        script: {
+          lead: [{ kind: "status", status, message: "model not found" }],
+          utility: [{ kind: "text", text: "ok" }],
+        },
+      });
+      let run: Run | undefined;
+      try {
+        const fixture = makeFixture(root);
+        const home = makeScratchHome(root, {
+          baseUrl: server.baseUrl,
+          model: "fake-model",
+          team: false,
+        });
+        run = spawnRun({
+          home,
+          fixture,
+          toolsBin: resolveRuneToolsBinary().path,
+          prompt: "say hello",
+        });
+        expect(await run.wait(30_000)).toBe(5);
+        expect(run.envelope()).toMatchObject({
+          ok: false,
+          stopReason: "model_unavailable",
+          subtype: "error_model_unavailable",
+          lifecycle: { status: "model_unavailable" },
+        });
+        expect(run.envelope()?.error).toContain("/model");
+        expect(server.countOf("lead")).toBe(1);
+      } finally {
+        run?.kill("SIGKILL");
+        server.stop();
+        rmTemp(root);
+      }
+    },
+    40_000,
+  );
+});
diff --git a/tests/unit/orchestrator/model-unavailable.test.ts b/tests/unit/orchestrator/model-unavailable.test.ts
new file mode 100644
index 00000000..4853aa68
--- /dev/null
+++ b/tests/unit/orchestrator/model-unavailable.test.ts
@@ -0,0 +1,130 @@
+import { describe, expect, test } from "bun:test";
+import { ApiError, LlmGateway, type LlmProvider } from "../../../packages/llm-gateway/src";
+import { AgentLoop, type AgentTurnEvent } from "../../../packages/orchestrator/src/agent-loop";
+import {
+  headlessEnvelope,
+  headlessExitCode,
+  runHeadless,
+} from "../../../packages/orchestrator/src/headless";
+import {
+  statusFromHandoffReason,
+  statusFromStopReason,
+} from "../../../packages/orchestrator/src/lifecycle";
+import { toChildStatus } from "../../../packages/orchestrator/src/subagent-result";
+import { TaskStateStore } from "../../../packages/orchestrator/src/task-state";
+import type { Engine } from "../../../packages/orchestrator/src/engine";
+
+async function runFailure(status: number, message: string, maxRetries = 0, maxRateWaits = 0) {
+  let calls = 0;
+  const gateway = new LlmGateway({
+    providers: {},
+    defaultProvider: "openrouter",
+    maxRetries,
+    retryBaseMs: 1,
+  });
+  gateway.registerProvider({
+    name: "openrouter",
+    async *inferStream() {
+      calls++;
+      throw new ApiError({ status, provider: "openrouter", message });
+    },
+  } as unknown as LlmProvider);
+  const taskState = new TaskStateStore();
+  taskState.setTodos([{ content: "unfinished work", status: "in_progress" }], { enforce: false });
+  const loop = new AgentLoop(
+    {
+      model: "test-model",
+      provider: "openrouter",
+      maxTokens: 100,
+      maxTurns: 8,
+      maxConsecutiveErrors: 1,
+      maxRateWaits,
+      systemPrompt: "s",
+      taskState,
+    },
+    gateway,
+    { toLlmTools: () => [] } as any,
+  );
+  const events: AgentTurnEvent[] = [];
+  const result = await runHeadless(
+    {
+      setPermissionHandler() {},
+      async *chat() {
+        for await (const event of loop.run("continue", "s1", "/ws")) {
+          events.push(event);
+          yield event;
+        }
+      },
+    } as unknown as Engine,
+    "s1",
+    "continue",
+  );
+  return { calls, events, result, taskState };
+}
+
+describe("model unavailable ending", () => {
+  test.each([404, 410])(
+    "HTTP %i stops immediately with its own headless ending",
+    async (status) => {
+      const { calls, events, result, taskState } = await runFailure(status, "model not found", 3);
+      expect(calls).toBe(1);
+      expect(events.at(-1)).toMatchObject({
+        type: "turn_complete",
+        stopReason: "model_unavailable",
+      });
+      const iHandoff = events.findIndex((e) => e.type === "handoff");
+      const iError = events.findIndex((e) => e.type === "error");
+      expect(iHandoff).toBeGreaterThanOrEqual(0);
+      expect(iHandoff).toBeLessThan(iError);
+      expect(events[iError]).toMatchObject({ recoverable: false });
+      expect(taskState.snapshot().handoff?.reason).toBe("model_unavailable");
+      expect(taskState.hasOpenTodos()).toBe(true);
+      expect(result.error).toContain("is gone");
+      expect(result.error).toContain("/model");
+      expect(JSON.parse(headlessEnvelope(result))).toMatchObject({
+        ok: false,
+        stopReason: "model_unavailable",
+        subtype: "error_model_unavailable",
+      });
+      expect(headlessExitCode(result)).toBe(5);
+      expect(result.resumeAt).toBeUndefined();
+    },
+  );
+
+  test("retirement guidance cannot trigger the rate-limit wait", async () => {
+    const { calls, result } = await runFailure(
+      410,
+      "model retired; all providers rate limited. Retry in ~1s",
+      3,
+      2,
+    );
+    expect(calls).toBe(1);
+    expect(result.stopReason).toBe("model_unavailable");
+  });
+
+  test("lifecycle and delegated results retain the ending", () => {
+    expect(statusFromStopReason("model_unavailable")).toBe("model_unavailable");
+    expect(statusFromHandoffReason("model_unavailable")).toBe("model_unavailable");
+    expect(toChildStatus("model_unavailable")).toBe("model_unavailable");
+  });
+
+  test.each([
+    [401, "invalid key", "provider_lost", "error_provider"],
+    [403, "forbidden", "provider_lost", "error_provider"],
+    [402, "no credits", "provider_lost", "error_provider"],
+    [429, "rate limited", "provider_lost", "error_provider"],
+    [429, "usage limit reached", "quota_wall", "error_quota"],
+    [503, "service unavailable", "provider_lost", "error_provider"],
+  ] as const)(
+    "HTTP %i (%s) keeps its existing ending",
+    async (status, message, stopReason, subtype) => {
+      const { result } = await runFailure(status, message);
+      expect(JSON.parse(headlessEnvelope(result))).toMatchObject({
+        ok: false,
+        stopReason,
+        subtype,
+      });
+      expect(headlessExitCode(result)).toBe(5);
+    },
+  );
+});
