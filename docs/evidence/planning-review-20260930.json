    "code": "import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { CommandVerifier, detectProjects, detectVerifyCommands, projectsForRun } from \"/Users/ritikyadav890/Project/Alan/packages/orchestrator/src/verifier.ts\";\nimport { corpusParityTasks } from \"/Users/ritikyadav890/Project/Alan/tests/eval/parity/corpus-source.ts\";\nimport { seriousTasks } from \"/Users/ritikyadav890/Project/Alan/tests/eval/serious/source.ts\";\nimport { scoreScope, gateBeforePair, isClean } from \"/Users/ritikyadav890/Project/Alan/tests/eval/parity/run-pairs.ts\";\n\nconst root = mkdtempSync(join(tmpdir(), \"rune-plan-review-\"));\nconst result: Record<string, unknown> = {};\ntry {\n  writeFileSync(join(root, \"package.json\"), JSON.stringify({ scripts: { test: \"bun test unit\" } }));\n  writeFileSync(join(root, \"bun.lock\"), \"\");\n  mkdirSync(join(root, \"unit\"));\n  writeFileSync(join(root, \"unit/ok.test.ts\"), 'import { test, expect } from \"bun:test\"; test(\"declared suite\", () => expect(1).toBe(1));');\n  mkdirSync(join(root, \"outside\"));\n  writeFileSync(join(root, \"outside/unrelated.test.ts\"), 'import { test, expect } from \"bun:test\"; test(\"excluded suite\", () => expect(1).toBe(2));');\n  const runScript = Bun.spawn([process.execPath, \"run\", \"test\"], {cwd: root, stdout: \"pipe\", stderr: \"pipe\"});\n  await Promise.all([new Response(runScript.stdout).text(), new Response(runScript.stderr).text()]);\n  const declaredExit = await runScript.exited;\n  const detected = detectVerifyCommands(root);\n  const verification = await new CommandVerifier({ workspaceRoot: root }).verify();\n  result.scriptSelection = { declaredExit, detected, verifierPassed: verification.passed, commands: verification.runs?.map(r => r.command) };\n  const timeout = await new CommandVerifier({ workspaceRoot: root, commands: [\"sleep 1\"], timeoutMs: 30 }).verify();\n  result.timeout = { passed: timeout.passed, ran: timeout.ran, timedOut: timeout.runs?.[0]?.timedOut, status: (timeout as any).status ?? null };\n  writeFileSync(join(root, \"Cargo.toml\"), '[package]\\nname=\"fixture\"\\nversion=\"0.1.0\"\\nedition=\"2021\"\\n');\n  const projects = detectProjects(root);\n  result.ecosystemSelection = Object.fromEntries([\"app.ts\", \"README.md\", \"Cargo.toml\"].map(file => [file, projectsForRun(projects, [file]).map(p => p.ecosystem)]));\n  const base = {head: \"same\", entries: {}, committed: []};\n  result.unrelatedCodeScope = scoreScope(base, {head: \"same\", entries: {\"unrelated.ts\": \" M changed\"}, committed: []}, {noCode:false});\n  result.quotaFirstPair = gateBeforePair({budgetUsd:null,quotaPct:90}, {pairsRun:0,spentUsd:0,costliestPairUsd:0,unknownCharge:false,runeQuotaPct:99}) ?? \"allowed\";\n  result.cleanWithoutExitCheck = isClean({stopped:undefined,durationMs:100}, 1000, false);\n  const repo = \"/Users/ritikyadav890/Project/Alan\";\n  const tasks = [...corpusParityTasks(join(repo,\"tests/eval/corpus\")), ...corpusParityTasks(join(repo,\"tests/eval/parity-tasks\")), ...seriousTasks({repoRoot:repo})];\n  result.taskFamilies = tasks.reduce((counts, task) => { counts[task.family] = (counts[task.family] ?? 0) + 1; return counts; }, {} as Record<string,number>);\n  result.taskTotal = tasks.length;\n  console.log(JSON.stringify(result, null, 2));\n} finally {\n  rmSync(root, {recursive:true,force:true});\n}\n"
