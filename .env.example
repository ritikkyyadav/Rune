# ─── Gear — free-tier dev/test keys ───
# Copy to `.env` (gitignored; Bun auto-loads it when you run from the repo),
# or just `export` these in your shell.
#
# These env vars still work exactly as before. As an alternative, you can sign in
# interactively with `gear login <provider>` — keys go into your OS keychain
# (macOS Keychain / libsecret / Windows DPAPI) instead of a file, and providers
# that document OAuth (e.g. OpenRouter) can be authorized in the browser with no
# key to paste. See docs/byop.md. Nothing here is required if you use `gear login`.

# Primary dev model: Google Gemini — generous free tier.
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Fallback: OpenRouter — has free models (e.g. deepseek/deepseek-v4-flash:free).
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fully local / offline (optional): point at a running Ollama server.
# OLLAMA_HOST=http://localhost:11434

# n8n workflow-trigger tool (optional).
# N8N_BASE_URL=http://localhost:5678

# ─── Web search (optional) — better data than the no-key DuckDuckGo fallback ───
# Tavily — search API built for LLMs (clean snippets + answers). https://tavily.com
# TAVILY_API_KEY=
# Brave Search API — independent index, generous free tier. https://brave.com/search/api
# BRAVE_API_KEY=
# Backend preference: auto | tavily | brave | duckduckgo (auto picks best available).
# GEAR_SEARCH_BACKEND=auto
# Provider-native grounding (Gemini googleSearch / Anthropic web_search) is ON by
# default on those providers; set to false to use the web_search tool everywhere.
# GEAR_NATIVE_GROUNDING=false

# ─── Paid top-tier — LEAVE UNSET during routine testing ───
# Only set these for a later production-validation eval pass.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Classifier-backed Auto mode (optional) ───
# Auto mode can also be enabled persistently in ~/.alan/config.toml. The
# reviewer defaults to Gear's heavy model tier; pin a distinct configured
# provider/model for stronger operational separation. Keep fail-closed on.
# GEAR_PERMISSION_MODE=confirm # confirm | autonomy-i | autonomy-ii | autonomy-iii | auto
# GEAR_AUTO_CLASSIFIER_PROVIDER=anthropic
# GEAR_AUTO_CLASSIFIER_MODEL=reviewer-model-id
# GEAR_AUTO_FAIL_CLOSED=true

# ─── Eval overrides (optional) ───
# The --real eval defaults to google / gemini-2.5-flash. To validate on top-tier:
# GEAR_EVAL_PROVIDER=anthropic
# GEAR_EVAL_MODEL=claude-sonnet-4-20250514
