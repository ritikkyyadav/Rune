# The Linux containment audit's image: rune-tools and rune-sandbox, built
# from THIS run's checkout, then clippy'd, unit-tested, and probed for what a
# sandboxed command can and cannot reach.
#
# This used to run by hand against the founder's Docker Desktop, which needs
# --privileged only because its VM refuses nested unprivileged user
# namespaces (which bubblewrap needs). That is a property of THAT rig, not of
# Rune's runtime, and must never reach the install script or a default. A
# native Linux CI runner may not even need --privileged for this, but this
# Dockerfile is the proven method, moved to where Docker works rather than
# changed — see .github/workflows/containment.yml for the flags it is run
# with and .codex/audit-20260910/handoff/ (phase-2c-report.md,
# fix/f1-report.md, verify/v1-report.md, verify/v4-report.md) for the audit
# trail this method comes from, including the toolchain-root symlink finding
# that scripts/containment/Dockerfile.probe re-checks live.
#
# scripts/containment/source.tar is generated by the workflow immediately
# before this build (`git ls-files -z | tar --null -T - -cf ...` — the
# COMMITTED tree, no working-tree residue; .codex/, node_modules/, target/
# and every credential store are excluded because git never tracked them) and
# is never itself committed — see .gitignore.
FROM oven/bun:1.3.14 AS bun
FROM rust:1.95-slim-bookworm
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update -qq && apt-get install -y -qq bubblewrap python3 nodejs curl git gcc g++ make pkg-config ca-certificates && rm -rf /var/lib/apt/lists/*
# rust:slim ships no clippy, and linux.rs is the one file macOS cannot lint.
RUN rustup component add clippy
WORKDIR /workspace
COPY source.tar /source.tar
RUN tar -xf /source.tar -C /workspace && rm /source.tar
RUN bun install --frozen-lockfile
RUN cargo build --locked -p rune-tools
# Both spellings, pointed at the binary this image just built: the suites
# prefer an explicit variable over whatever is under target/.
ENV RUNE_TOOLS_BIN=/workspace/target/debug/rune-tools
ENV RUNE_TOOLS_BINARY=/workspace/target/debug/rune-tools
# Fixtures for the toolchain-visibility check: one home toolchain directory
# that MUST be reachable, and two home secrets that must NOT be. Synthetic
# values only — no host credential is ever copied into this image.
RUN mkdir -p /root/.local/bin /root/.ssh \
    && printf '#!/bin/sh\necho home-toolchain-ok\n' > /root/.local/bin/rune-probe-tool \
    && chmod +x /root/.local/bin/rune-probe-tool \
    && echo SYNTHETIC-CREDENTIAL > /root/.ssh/id_rsa \
    && echo SYNTHETIC-CREDENTIAL > /root/.rune-secret
COPY run-suite.sh /run-suite.sh
CMD ["bash", "/run-suite.sh"]
