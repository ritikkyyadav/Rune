{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts"],
  // The corpus's fixture, solution and variant trees are DATA: deliberately
  // broken starting points, and files that import a sibling the fixture only
  // grows at run time. They are typechecked where they are materialised, not
  // here.
  "exclude": [
    "node_modules",
    "results",
    "corpus/*/fixture",
    "corpus/*/untracked",
    "corpus/*/solution",
    "corpus/*/variants"
  ]
}
