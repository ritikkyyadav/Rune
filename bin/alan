#!/usr/bin/env bash
# Alan — Sovereign Agentic Coding Assistant by Savoir Studio
# Just type `alan` from any directory to start.

set -euo pipefail

ALAN_ROOT="/Users/ritikyadav890/Documents/Alan"
ALAN_ENV="$HOME/.alan/.env"
ALAN_CONFIG="$HOME/.alan/config.toml"

# ─── Load API keys from ~/.alan/.env ───
if [ -f "$ALAN_ENV" ]; then
  set -a
  source "$ALAN_ENV"
  set +a
fi

# ─── Resolve bun ───
BUN="${HOME}/.bun/bin/bun"
if ! [ -x "$BUN" ]; then
  BUN="$(command -v bun 2>/dev/null || true)"
fi
if [ -z "$BUN" ]; then
  echo "Error: bun not found. Install it: curl -fsSL https://bun.sh/install | bash" >&2
  exit 1
fi

# ─── Ensure ~/.alan exists ───
mkdir -p "$HOME/.alan"

# ─── Workspace = current directory ───
WORKSPACE="${PWD}"

# ─── Export tool binary path so the TS CLI finds it ───
export ALAN_TOOLS_BIN="$ALAN_ROOT/target/release/alan-tools"

# ─── Launch ───
exec "$BUN" run "$ALAN_ROOT/packages/orchestrator/src/bin/alan-cli.ts" \
  --workspace "$WORKSPACE" \
  "$@"
